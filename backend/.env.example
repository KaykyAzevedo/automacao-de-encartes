# Servidor
PORT=5000
NODE_ENV=development

# Origem permitida para CORS (frontend)
CORS_ORIGIN=http://localhost:3000

# Banco de dados
# Dev local sem Postgres instalado: rode `npx prisma dev --name encarte`
# e cole aqui as duas URLs que ele imprime (as portas mudam a cada execucao).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/encarte_gerador?schema=public"
SHADOW_DATABASE_URL=""

# Storage de imagens (AWS S3) - preencher quando a etapa de upload entrar
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
