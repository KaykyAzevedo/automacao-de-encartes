# Modo de autenticacao
# "local"  = sem login, tudo roda como um usuario local fixo (uso pessoal)
# "google" = exige sessao do NextAuth; precisa das credenciais do Google
AUTH_MODE=local
LOCAL_USER_EMAIL=local@encarte.local

# Servidor
PORT=5000
NODE_ENV=development

# Origem permitida para CORS (frontend)
CORS_ORIGIN=http://localhost:3000

# Banco de dados
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/encarte?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/encarte_shadow?schema=public"

# Storage de imagens (AWS S3) - preencher quando a etapa de upload entrar
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
