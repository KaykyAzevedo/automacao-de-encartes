# Modo de autenticacao (precisa ser o MESMO do backend)
# "local"  = sem login, tudo roda como um usuario local fixo
# "google" = mostra a tela de login e exige credenciais do Google abaixo
AUTH_MODE=local
LOCAL_USER_EMAIL=local@encarte.local

# URL base da API do backend
NEXT_PUBLIC_API_URL=http://localhost:5000

# NextAuth
# Gere o secret com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Callback autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Banco - mesma URL usada pelo backend
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/encarte?schema=public"
