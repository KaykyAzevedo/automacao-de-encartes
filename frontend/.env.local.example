# URL base da API do backend
NEXT_PUBLIC_API_URL=http://localhost:5000

# NextAuth
# Gere o secret com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Callback autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Banco - mesma URL usada pelo backend
DATABASE_URL="postgresql://usuario:senha@localhost:5432/encarte_gerador?schema=public"
